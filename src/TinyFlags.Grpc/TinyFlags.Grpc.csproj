<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0-dev</Version>
    <Description>The reference gRPC transport for TinyFlags - real-time value updates and independent registration, speaking the documented tinyflags.proto contract against TinyFlags.Server or your own implementation.</Description>
    <PackageTags>feature-flags;grpc;dotnet;tinyflags</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyFlags.Grpc 0.1.0-alpha.1

      Added
      - Reference gRPC transport: registration plus real-time push value synchronization over a Watch stream.
      - Automatic reconnect on transient failures; permanent failures surface as TinyFlagsClientException.
      - Strict response validation, consistent with the HTTP transport's failure classification (docs/grpc-protocol.md).

      Compatibility
      - Early alpha, matches TinyFlags's contract version.
      - Upgrade TinyFlags, TinyFlags.Http and TinyFlags.Grpc together.
    </PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.84.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
    <PackageReference Include="Grpc.Tools" Version="2.84.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TinyFlags.Grpc.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TinyFlags/TinyFlags.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
  <ItemGroup>
    <Protobuf Include="Protos/tinyflags.proto" GrpcServices="Client" />
  </ItemGroup>
</Project>
