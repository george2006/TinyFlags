<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0-dev</Version>
    <!-- NuGet distribution identity only - "TinyFlags" on nuget.org already belongs to another
         publisher. The product, namespaces, and every public type stay TinyFlags. -->
    <PackageId>TinySuite.TinyFlags</PackageId>
    <Description>Typed feature flag declarations for TinyFlags.</Description>
    <PackageTags>feature-flags;source-generator;dotnet;dependency-injection;tinyflags</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyFlags 0.1.0-alpha.3

      Added
      - Typed feature-flag declarations via IFeatureProvider, with compile-time-generated access classes.
      - Local-only FeatureValues store, or connect to a server through a transport package.
      - Transport contracts (IFeatureDefinitionsTransport, IFeatureValuesTransport, IFeatureValuesSubscription)
        any package can implement - see TinyFlags.Http and TinyFlags.Grpc for two real examples.
      - Multi-assembly catalog composition via TinyFlagsBootstrap.
      - Source-generator diagnostics (TFG001-TFG005) for unsupported declarations.

      Fixed
      - README/docs still said "not yet published to NuGet.org" and gave local-pack install
        instructions after alpha.2 had actually shipped; now point at the real package id.

      Compatibility
      - Early alpha: API surface, especially the transport contracts, may still change before 1.0.
      - Upgrade TinyFlags, TinyFlags.Http and TinyFlags.Grpc together.
    </PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TinyFlags.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TinyFlags.SourceGen/TinyFlags.SourceGen.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../TinyFlags.SourceGen/bin/$(Configuration)/netstandard2.0/TinyFlags.SourceGen.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
