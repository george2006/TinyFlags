<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0-dev</Version>
    <Description>Typed feature flag declarations for TinyFlags.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TinyFlags.Tests" />
    <InternalsVisibleTo Include="TinyFlags.Server.IntegrationTests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TinyFlags.SourceGen/TinyFlags.SourceGen.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../TinyFlags.SourceGen/bin/$(Configuration)/netstandard2.0/TinyFlags.SourceGen.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
