<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.1.0-dev</Version>
    <!-- NuGet distribution identity only - see TinyFlags.csproj's PackageId comment. -->
    <PackageId>TinySuite.TinyFlags.Http</PackageId>
    <Description>The reference HTTP transport for TinyFlags, speaking the documented wire protocol against TinyFlags.Server or your own implementation.</Description>
    <PackageTags>feature-flags;http;dotnet;tinyflags</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <PropertyGroup>
    <PackageReleaseNotes>
      TinyFlags.Http 0.1.0-alpha.4

      Added
      - Reference HTTP transport: registration plus polling value synchronization with conditional GET/ETag.
      - Retry with jittered exponential backoff, honoring Retry-After.
      - Strict response validation against the documented wire contract (docs/protocol.md).

      Fixed
      - The README bundled in alpha.3 was a stale snapshot from before several docs fixes; this
        release re-packs the current README.

      Compatibility
      - Early alpha, matches TinyFlags's contract version.
      - Upgrade TinyFlags, TinyFlags.Http and TinyFlags.Grpc together.
    </PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="TinyFlags.Http.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../TinyFlags/TinyFlags.csproj" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
